{
	"name": "PL_File_Copy_Based_On_Size",
	"properties": {
		"activities": [
			{
				"name": "List Source File",
				"description": "Lists the file name and type",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "Wait for 60 seconds",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_Binary_Source",
						"type": "DatasetReference",
						"parameters": {
							"container_name": "demo-container",
							"folder": "source"
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "For Each File and Type",
				"description": "File names and type in a array is iterated",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Filter1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Filter1').output.Value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Source File Size",
							"type": "GetMetadata",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "DS_ADLS_source_file",
									"type": "DatasetReference",
									"parameters": {
										"container_name": "demo-container",
										"folder_name": "source",
										"file_name": {
											"value": "@item().name",
											"type": "Expression"
										}
									}
								},
								"fieldList": [
									"size",
									"itemName"
								],
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "BinaryReadSettings"
								}
							}
						},
						{
							"name": "If Size Matches",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Source File Size",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@greater(activity('Source File Size').output.size, 30)",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "Copy Files",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "BinarySource",
												"storeSettings": {
													"type": "AzureBlobFSReadSettings",
													"recursive": true,
													"wildcardFolderPath": "source",
													"wildcardFileName": {
														"value": "@activity('Source File Size').output.itemName",
														"type": "Expression"
													},
													"deleteFilesAfterCompletion": false
												},
												"formatSettings": {
													"type": "BinaryReadSettings"
												}
											},
											"sink": {
												"type": "BinarySink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												}
											},
											"enableStaging": false
										},
										"inputs": [
											{
												"referenceName": "DS_Binary_Source",
												"type": "DatasetReference",
												"parameters": {
													"container_name": "demo-container",
													"folder": "source"
												}
											}
										],
										"outputs": [
											{
												"referenceName": "DS_Binary_Target",
												"type": "DatasetReference",
												"parameters": {
													"conatiner_name": "demo-container",
													"folder_name": "target",
													"file_name": {
														"value": "@activity('Source File Size').output.itemName",
														"type": "Expression"
													}
												}
											}
										]
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "Filter1",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "List Source File",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('List Source File').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@startswith(item().name, 'a')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Wait for 60 seconds",
				"type": "Wait",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"waitTimeInSeconds": 60
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-11-20T08:55:29Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}