{
	"name": "PL_EMAIL_DEMO_Multiple",
	"properties": {
		"activities": [
			{
				"name": "Send Email",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Prepare logic App Body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": "https://prod-16.centralindia.logic.azure.com:443/workflows/a57ca166700c4eea95526ed2e2216505/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=N56T3QeVPkpAGwfOoIUehAYHfXcQfTT9eXf7hJeLBwE",
					"body": {
						"value": "@variables('logic_apps_body')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Prepare logic App Body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Prepare Email Body",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare Email Subject",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_apps_body",
					"value": {
						"value": "{\"email_recepient\": \"@{pipeline().parameters.email_recepients}\",\n\"subject\": \"@{variables('email_subject')}\",\n\"body\": \"@{variables('email_body')}\"}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Prepare Email Subject",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "Ingestion Completed",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Prepare Email Body",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_body",
					"value": {
						"value": "Ingestion process has been completed for all tables and below is the status.\n@{replace(string(pipeline().parameters.table_status), '\"','')}\n\nPipeline Run id = @{pipeline().RunId}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"email_recepients": {
				"type": "string"
			},
			"table_status": {
				"type": "array"
			}
		},
		"variables": {
			"logic_apps_body": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"email_body": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-11-19T07:04:25Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
