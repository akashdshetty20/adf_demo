{
	"name": "PL_Copy_from_Azure_SQL_to_ADLS",
	"properties": {
		"activities": [
			{
				"name": "Execute Send Email Success",
				"type": "ExecutePipeline",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Check Source Count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_EMAIL_DEMO",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"table_name": {
							"value": "@pipeline().parameters.table_name",
							"type": "Expression"
						},
						"status": "SUCCESS",
						"email_recepients": {
							"value": "@pipeline().globalParameters.email_recepient",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Execute Send Email Failure",
				"type": "ExecutePipeline",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Check Source Count",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_EMAIL_DEMO",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"table_name": {
							"value": "@pipeline().parameters.table_name",
							"type": "Expression"
						},
						"status": "FAILED",
						"email_recepients": {
							"value": "@pipeline().globalParameters.email_recepient",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Read Watermark",
				"description": "Read watermark from azure sql table.",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select watermark_value\nfrom metadata.table_watermarks\nwhere table_name = '@{pipeline().parameters.table_name}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSQL",
						"type": "DatasetReference",
						"parameters": {
							"schema_name": "dbo",
							"table_name": "customers"
						}
					}
				}
			},
			{
				"name": "Check Source Count",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Check Count in Source",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(activity('Check Count in Source').output.firstRow.record_count, 0)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Ingest_SQL_DB_Data",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "select *\nfrom @{pipeline().parameters.schema_name}.@{pipeline().parameters.table_name}\nwhere modifieddate > '@{activity('Read Watermark').output.firstRow.watermark_value}';",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_AzureSQL",
									"type": "DatasetReference",
									"parameters": {
										"schema_name": {
											"value": "@pipeline().parameters.schema_name",
											"type": "Expression"
										},
										"table_name": {
											"value": "@pipeline().parameters.table_name",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_ADLS_csv",
									"type": "DatasetReference",
									"parameters": {
										"table_name": {
											"value": "@toLower(pipeline().parameters.table_name)",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Update Watermark",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "Ingest_SQL_DB_Data",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_AzureSQL",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "update metadata.table_watermarks\nset watermark_value = sysutcdatetime()\nwhere table_name = '@{pipeline().parameters.table_name}'",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			},
			{
				"name": "Check Count in Source",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Read Watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select count(*) as record_count\nfrom @{pipeline().parameters.schema_name}.@{pipeline().parameters.table_name}\nwhere ModifiedDate > '@{activity('Read Watermark').output.firstRow.watermark_value}';",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSQL",
						"type": "DatasetReference",
						"parameters": {
							"schema_name": "dbo",
							"table_name": "customers"
						}
					}
				}
			}
		],
		"parameters": {
			"schema_name": {
				"type": "string",
				"defaultValue": "dbo"
			},
			"table_name": {
				"type": "string",
				"defaultValue": "customers"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-11-19T07:04:25Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}