{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-learning-central-india"
		},
		"LS_AzureSQL_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AzureSQL'"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://demoadlsacccentralindia.dfs.core.windows.net/"
		},
		"LS_AzureSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-server-demo-central-india.database.windows.net"
		},
		"LS_AzureSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sql-database-demo"
		},
		"LS_AzureSQL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "mysqlserver"
		},
		"TGR_EVENT_properties_PL_File_Event_parameters_file_name": {
			"type": "string",
			"defaultValue": "@triggerBody().fileName"
		},
		"TGR_EVENT_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/d840f11c-7300-4be7-a5c5-f31be09fb998/resourceGroups/rg-adf-central-india/providers/Microsoft.Storage/storageAccounts/demoadlsacccentralindia"
		},
		"TR_Tumbling_Window_Orders_properties_pipeline_parameters_window_start": {
			"type": "string",
			"defaultValue": "@trigger().outputs.windowStartTime"
		},
		"TR_Tumbling_Window_Orders_properties_pipeline_parameters_window_end": {
			"type": "string",
			"defaultValue": "@trigger().outputs.windowEndTime"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-learning-central-india_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_AzureSQL_password": {
						"value": "[parameters('LS_AzureSQL_password')]"
					},
					"LS_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_properties_typeProperties_url')]"
					},
					"LS_AzureSQL_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSQL_properties_typeProperties_server')]"
					},
					"LS_AzureSQL_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSQL_properties_typeProperties_database')]"
					},
					"LS_AzureSQL_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSQL_properties_typeProperties_userName')]"
					},
					"TGR_EVENT_properties_PL_File_Event_parameters_file_name": {
						"value": "[parameters('TGR_EVENT_properties_PL_File_Event_parameters_file_name')]"
					},
					"TGR_EVENT_properties_typeProperties_scope": {
						"value": "[parameters('TGR_EVENT_properties_typeProperties_scope')]"
					},
					"TR_Tumbling_Window_Orders_properties_pipeline_parameters_window_start": {
						"value": "[parameters('TR_Tumbling_Window_Orders_properties_pipeline_parameters_window_start')]"
					},
					"TR_Tumbling_Window_Orders_properties_pipeline_parameters_window_end": {
						"value": "[parameters('TR_Tumbling_Window_Orders_properties_pipeline_parameters_window_end')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}